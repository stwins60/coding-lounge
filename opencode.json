{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "lounge_project": {
      "type": "local",
      "command": [".venv/Scripts/python.exe", "mcp-servers/project_server.py"],
      "cwd": ".",
      "enabled": true,
      "environment": {
        "LOUNGE_ROOT": "."
      }
    },
    "lounge_notes": {
      "type": "local",
      "command": [".venv/Scripts/python.exe", "mcp-servers/notes_server.py"],
      "cwd": ".",
      "enabled": true,
      "environment": {
        "LOUNGE_NOTES_DIR": "mcp-servers/data/notes"
      }
    },
    "lounge_math": {
      "type": "local",
      "command": [".venv/Scripts/python.exe", "mcp-servers/math_server.py"],
      "cwd": ".",
      "enabled": true
    }
  }
}